{
    auto_https disable_redirects
}

{$SITE_ADDRESS::80} {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }

    encode gzip

    request_body {
        max_size 3MB
    }

    handle_path /api/* {
        reverse_proxy api:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}